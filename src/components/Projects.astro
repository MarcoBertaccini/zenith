---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const slots = [t('projects.slot1'), t('projects.slot2'), t('projects.slot3')];
---

<section id="progetti" class="py-24 md:py-32 border-t border-line/60">
  <div class="mx-auto max-w-content px-6">
    <div class="max-w-2xl mb-16">
      <p class="eyebrow mb-4" data-reveal>{t('projects.eyebrow')}</p>
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight" data-reveal>
        {t('projects.heading')}
      </h2>
      <p class="mt-5 text-fg-muted text-lg" data-reveal>{t('projects.body')}</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {slots.map((slot, i) => (
        <div
          class="hairline rounded-2xl p-8 flex flex-col justify-between min-h-[180px]"
          data-reveal
          style={`transition-delay:${i * 80}ms`}
        >
          <span class="font-mono text-[11px] tracking-wide text-fg-subtle border border-line rounded-full px-3 py-1 w-fit">
            {t('projects.slot.badge')}
          </span>
          <p class="mt-8 text-fg-muted">{slot}</p>
        </div>
      ))}
    </div>
  </div>
</section>
