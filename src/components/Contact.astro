---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import LeadFunnel from './islands/LeadFunnel';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contatti" class="py-32 border-t border-line">
  <div class="mx-auto max-w-content px-6 grid lg:grid-cols-2 gap-16 items-start">
    <div class="lg:sticky lg:top-32">
      <h2 class="text-3xl md:text-4xl font-display font-semibold tracking-tight" data-reveal>
        <span class="text-fg-muted">{t('contact.heading.muted')}</span>{' '}
        <span class="text-fg">{t('contact.heading.fg')}</span>
      </h2>
      <p class="mt-5 text-fg-body text-lg max-w-[50ch]" data-reveal>{t('contact.sub')}</p>
    </div>

    <div data-reveal>
      <LeadFunnel lang={lang} client:visible />
    </div>
  </div>
</section>
