---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import LeadFunnel from './islands/LeadFunnel';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contatti" class="py-32 border-t border-line">
  <div class="mx-auto max-w-content px-6 grid lg:grid-cols-2 gap-16 items-start">
    <div class="lg:sticky lg:top-32">
      <h2 class="text-3xl md:text-4xl font-display font-semibold tracking-tight" data-reveal>
        <span class="text-fg-muted">{t('contact.heading.muted')}</span>{' '}
        <span class="text-fg">{t('contact.heading.fg')}</span>
      </h2>
      <p class="mt-5 text-fg-body text-lg max-w-[50ch]" data-reveal>{t('contact.sub')}</p>

      <div class="mt-10 hairline rounded-card p-6" data-reveal>
        <p class="eyebrow mb-1">{t('contact.alt.eyebrow')}</p>
        <p class="text-sm text-fg-body mb-4">{t('contact.alt.sub')}</p>
        <div class="flex flex-wrap gap-3">
          <a
            href="https://wa.me/393793820699?text=Ciao%21%20Ho%20visto%20il%20sito%20e%20vorrei%20qualche%20informazione."
            target="_blank"
            rel="noopener"
            class="btn-secondary"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
            </svg>
            {t('contact.alt.whatsapp')}
          </a>
          <a href="tel:+393793820699" class="btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" />
            </svg>
            {t('contact.alt.call')}
          </a>
        </div>
      </div>
    </div>

    <div data-reveal>
      <LeadFunnel lang={lang} client:visible />
    </div>
  </div>
</section>
