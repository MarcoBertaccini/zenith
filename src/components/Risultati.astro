---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = [
  { title: t('risultati.item1.title'), desc: t('risultati.item1.desc') },
  { title: t('risultati.item2.title'), desc: t('risultati.item2.desc') },
  { title: t('risultati.item3.title'), desc: t('risultati.item3.desc') },
];
---

<section id="risultati" class="py-24 bg-paper text-paper-ink">
  <div class="mx-auto max-w-content px-6">
    <h2 class="text-2xl md:text-3xl font-display font-semibold tracking-tight mb-16 max-w-xl" data-reveal>
      <span class="text-paper-ink/50">{t('risultati.heading.muted')}</span>{' '}
      <span class="text-paper-ink">{t('risultati.heading.fg')}</span>
    </h2>

    <div class="grid md:grid-cols-3 gap-12 md:gap-8">
      {items.map((item, i) => (
        <div
          class={i > 0 ? 'md:border-l md:border-paper-ink/10 md:pl-8' : ''}
          data-reveal
          style={`transition-delay:${i * 80}ms`}
        >
          <p class="text-3xl md:text-4xl font-display font-semibold tracking-tight">{item.title}</p>
          <p class="mt-3 text-paper-ink/70 max-w-[38ch]">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
