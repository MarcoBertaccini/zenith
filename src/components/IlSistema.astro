---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import SistemaCard from './SistemaCard.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = [
  { n: 1, title: t('sistema.step1.title'), desc: t('sistema.step1.desc') },
  { n: 2, title: t('sistema.step2.title'), desc: t('sistema.step2.desc') },
  { n: 3, title: t('sistema.step3.title'), desc: t('sistema.step3.desc') },
  { n: 4, title: t('sistema.step4.title'), desc: t('sistema.step4.desc') },
];
---

<section id="il-sistema" class="sistema py-40 border-t border-line">
  <div class="mx-auto max-w-content px-6">
    <div class="max-w-2xl mb-16 lg:mb-24">
      <h2 class="text-3xl md:text-4xl font-display font-semibold tracking-tight" data-reveal>
        <span class="text-fg-muted">{t('sistema.heading.muted')}</span>{' '}
        <span class="text-fg">{t('sistema.heading.fg')}</span>
      </h2>
      <p class="mt-5 text-fg-body text-lg" data-reveal>{t('sistema.sub')}</p>
    </div>

    <!-- Desktop: sticky visual + scrolling text -->
    <div class="hidden lg:grid grid-cols-2 gap-16 sistema-desktop">
      <div>
        {steps.map((step) => (
          <div class="sistema-text-item" data-step-text={step.n}>
            <span class="font-mono text-sm text-accent-500">{`0${step.n}`}</span>
            <h3 class="mt-4 text-2xl font-display font-medium">{step.title}</h3>
            <p class="mt-3 text-fg-body max-w-[42ch]">{step.desc}</p>
          </div>
        ))}
      </div>
      <div class="sistema-sticky">
        <div class="sistema-cards">
          {steps.map((step) => (
            <div class="sistema-card" data-step-card={step.n}>
              <SistemaCard step={step.n as 1 | 2 | 3 | 4} lang={lang} />
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Mobile/tablet: stacked text + card pairs -->
    <div class="lg:hidden flex flex-col gap-16">
      {steps.map((step) => (
        <div data-reveal>
          <span class="font-mono text-sm text-accent-500">{`0${step.n}`}</span>
          <h3 class="mt-4 text-2xl font-display font-medium">{step.title}</h3>
          <p class="mt-3 text-fg-body max-w-[42ch]">{step.desc}</p>
          <div class="mt-6 max-w-sm h-[280px]">
            <SistemaCard step={step.n as 1 | 2 | 3 | 4} lang={lang} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-step-text]');
  const cards = document.querySelectorAll<HTMLElement>('[data-step-card]');

  if (items.length && 'IntersectionObserver' in window) {
    const setActive = (step: string) => {
      cards.forEach((card) => {
        card.classList.toggle('is-active', card.dataset.stepCard === step);
      });
      items.forEach((item) => {
        item.classList.toggle('is-active', item.dataset.stepText === step);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActive((entry.target as HTMLElement).dataset.stepText!);
          }
        });
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
    );

    items.forEach((item) => observer.observe(item));
    setActive('1');
  }
</script>

<style>
  .sistema-text-item {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0.35;
    transition: opacity 0.4s ease;
  }

  .sistema-text-item.is-active {
    opacity: 1;
  }

  .sistema-text-item:first-child {
    min-height: 50vh;
  }

  .sistema-text-item:last-child {
    min-height: 50vh;
  }

  .sistema-sticky {
    position: sticky;
    top: 8rem;
    height: 420px;
    align-self: start;
  }

  .sistema-cards {
    position: relative;
    height: 100%;
  }

  .sistema-card {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    pointer-events: none;
  }

  .sistema-card.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .sistema-text-item,
    .sistema-card {
      transition: none;
    }
  }
</style>

