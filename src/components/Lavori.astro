---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = [
  {
    img: '/work/bblavilla.webp',
    href: 'https://www.bblavilla.com',
    url: 'bblavilla.com',
    label: t('lavori.item1.label'),
    caption: t('lavori.item1.caption'),
  },
  {
    img: '/work/crinalirunning.webp',
    href: 'https://www.crinalirunning.it',
    url: 'crinalirunning.it',
    label: t('lavori.item2.label'),
    caption: t('lavori.item2.caption'),
  },
  {
    img: '/work/asfaltimirko.webp',
    href: 'https://asfaltimirko.it',
    url: 'asfaltimirko.it',
    label: t('lavori.item3.label'),
    caption: t('lavori.item3.caption'),
  },
  {
    img: '/work/relabcenter.webp',
    href: 'https://relab-center.it',
    url: 'relab-center.it',
    label: t('lavori.item4.label'),
    caption: t('lavori.item4.caption'),
  },
];
---

<section id="lavori" class="py-32 border-t border-line">
  <div class="mx-auto max-w-content px-6">
    <div class="max-w-2xl mb-16">
      <h2 class="text-3xl md:text-4xl font-display font-semibold tracking-tight" data-reveal>
        <span class="text-fg-muted">{t('lavori.heading.muted')}</span>{' '}
        <span class="text-fg">{t('lavori.heading.fg')}</span>
      </h2>
      <p class="mt-5 text-fg-body text-lg max-w-[60ch]" data-reveal>{t('lavori.sub')}</p>
    </div>

    <div class="grid lg:grid-cols-12 gap-6">
      <div class="lg:col-span-7" data-reveal>
        <a class="browser-frame block" href={items[0].href} target="_blank" rel="noopener">
          <div class="browser-chrome">
            <span></span><span></span><span></span>
            <span class="browser-url">{items[0].url}</span>
          </div>
          <img src={items[0].img} alt={items[0].label} class="w-full h-auto block" loading="lazy" />
        </a>
        <div class="mt-4">
          <p class="text-fg font-medium">{items[0].label}</p>
          <p class="text-sm text-fg-subtle">{items[0].caption}</p>
        </div>
      </div>

      <div class="lg:col-span-5 flex flex-col gap-6">
        {items.slice(1).map((item, i) => (
          <div data-reveal style={`transition-delay:${i * 80}ms`}>
            <a class="browser-frame block" href={item.href} target="_blank" rel="noopener">
              <div class="browser-chrome">
                <span></span><span></span><span></span>
                <span class="browser-url">{item.url}</span>
              </div>
              <img src={item.img} alt={item.label} class="w-full h-auto block" loading="lazy" />
            </a>
            <div class="mt-4">
              <p class="text-fg font-medium">{item.label}</p>
              <p class="text-sm text-fg-subtle">{item.caption}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .browser-frame {
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 16px;
    overflow: hidden;
    background: #16161a;
    transition: border-color 0.2s ease;
  }

  .browser-frame:hover {
    border-color: rgb(255 181 71 / 0.4);
  }

  .browser-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .browser-chrome span:not(.browser-url) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.16);
  }

  .browser-url {
    margin-left: 8px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    color: #7a7a78;
  }
</style>
