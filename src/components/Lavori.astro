---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = [
  { url: 'trattoria-delborgo.it', label: t('lavori.item1.label'), caption: t('lavori.item1.caption') },
  { url: 'bottega-nora.it', label: t('lavori.item2.label'), caption: t('lavori.item2.caption') },
  { url: 'studio-bellavista.it', label: t('lavori.item3.label'), caption: t('lavori.item3.caption') },
];
---

<section id="lavori" class="py-32 border-t border-line">
  <div class="mx-auto max-w-content px-6">
    <div class="max-w-2xl mb-16">
      <h2 class="text-3xl md:text-4xl font-display font-semibold tracking-tight" data-reveal>
        <span class="text-fg-muted">{t('lavori.heading.muted')}</span>{' '}
        <span class="text-fg">{t('lavori.heading.fg')}</span>
      </h2>
      <p class="mt-5 text-fg-body text-lg max-w-[60ch]" data-reveal>{t('lavori.sub')}</p>
    </div>

    <div class="grid lg:grid-cols-12 gap-6">
      <div class="lg:col-span-7" data-reveal>
        <div class="browser-frame">
          <div class="browser-chrome">
            <span></span><span></span><span></span>
            <span class="browser-url">{items[0].url}</span>
          </div>
          <div class="mock-page mock-page-lg">
            <div class="mock-nav"></div>
            <div class="mock-hero"></div>
            <div class="mock-lines">
              <span class="w-2/3"></span>
              <span class="w-1/2"></span>
            </div>
            <div class="mock-btn"></div>
          </div>
        </div>
        <div class="mt-4 flex items-baseline justify-between gap-4">
          <div>
            <p class="text-fg font-medium">{items[0].label}</p>
            <p class="text-sm text-fg-subtle">{items[0].caption}</p>
          </div>
          <span class="font-mono text-[11px] text-fg-subtle border border-line rounded-full px-3 py-1 shrink-0">
            {t('lavori.mockup.badge')}
          </span>
        </div>
      </div>

      <div class="lg:col-span-5 flex flex-col gap-6">
        {items.slice(1).map((item, i) => (
          <div data-reveal style={`transition-delay:${i * 80}ms`}>
            <div class="browser-frame">
              <div class="browser-chrome">
                <span></span><span></span><span></span>
                <span class="browser-url">{item.url}</span>
              </div>
              <div class="mock-page mock-page-sm">
                <div class="mock-nav"></div>
                <div class="mock-hero"></div>
                <div class="mock-lines">
                  <span class="w-1/2"></span>
                </div>
              </div>
            </div>
            <div class="mt-4 flex items-baseline justify-between gap-4">
              <div>
                <p class="text-fg font-medium">{item.label}</p>
                <p class="text-sm text-fg-subtle">{item.caption}</p>
              </div>
              <span class="font-mono text-[11px] text-fg-subtle border border-line rounded-full px-3 py-1 shrink-0">
                {t('lavori.mockup.badge')}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .browser-frame {
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 16px;
    overflow: hidden;
    background: #16161a;
  }

  .browser-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .browser-chrome span:not(.browser-url) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.16);
  }

  .browser-url {
    margin-left: 8px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    color: #7a7a78;
  }

  .mock-page {
    padding: 20px;
  }

  .mock-nav {
    height: 8px;
    width: 40%;
    border-radius: 4px;
    background: #1e1e23;
    margin-bottom: 20px;
  }

  .mock-hero {
    border-radius: 10px;
    background: linear-gradient(135deg, #1e1e23 0%, #16161a 100%);
    margin-bottom: 16px;
  }

  .mock-page-lg .mock-hero {
    height: 220px;
  }

  .mock-page-sm .mock-hero {
    height: 110px;
  }

  .mock-lines {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
  }

  .mock-lines span {
    height: 8px;
    border-radius: 4px;
    background: #1e1e23;
  }

  .mock-btn {
    width: 96px;
    height: 28px;
    border-radius: 8px;
    background: #ffb547;
  }
</style>
