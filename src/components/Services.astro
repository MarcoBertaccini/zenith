---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  {
    title: t('services.web.title'),
    desc: t('services.web.desc'),
    tags: [t('services.web.tag1'), t('services.web.tag2'), t('services.web.tag3'), t('services.web.tag4')],
  },
  {
    title: t('services.automation.title'),
    desc: t('services.automation.desc'),
    tags: [
      t('services.automation.tag1'),
      t('services.automation.tag2'),
      t('services.automation.tag3'),
      t('services.automation.tag4'),
    ],
  },
  {
    title: t('services.ai.title'),
    desc: t('services.ai.desc'),
    tags: [t('services.ai.tag1'), t('services.ai.tag2'), t('services.ai.tag3'), t('services.ai.tag4')],
  },
];
---

<section id="servizi" class="py-24 md:py-32 border-t border-line/60">
  <div class="mx-auto max-w-content px-6">
    <div class="max-w-2xl mb-16">
      <p class="eyebrow mb-4" data-reveal>{t('services.eyebrow')}</p>
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight" data-reveal>
        {t('services.heading')}
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {services.map((service, i) => (
        <div
          class="hairline rounded-2xl p-8 hover-lift hover:border-accent-500/50"
          data-reveal
          style={`transition-delay:${i * 80}ms`}
        >
          <h3 class="text-xl font-display font-medium">{service.title}</h3>
          <p class="mt-3 text-sm text-fg-muted leading-relaxed">{service.desc}</p>
          <ul class="mt-6 flex flex-wrap gap-2">
            {service.tags.map((tag) => (
              <li class="font-mono text-[11px] tracking-wide text-fg-subtle border border-line rounded-full px-3 py-1">
                {tag}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
