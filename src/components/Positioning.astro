---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pillars = [
  { title: t('positioning.pillar1.title'), desc: t('positioning.pillar1.desc') },
  { title: t('positioning.pillar2.title'), desc: t('positioning.pillar2.desc') },
  { title: t('positioning.pillar3.title'), desc: t('positioning.pillar3.desc') },
];
---

<section id="cosa-facciamo" class="py-24 md:py-32 border-t border-line/60">
  <div class="mx-auto max-w-content px-6">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4" data-reveal>{t('positioning.eyebrow')}</p>
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight" data-reveal>
        {t('positioning.heading')}
      </h2>
      <p class="mt-5 text-fg-muted text-lg" data-reveal>{t('positioning.body')}</p>
    </div>

    <div class="mt-16 grid md:grid-cols-3 gap-px bg-line/60 hairline">
      {pillars.map((pillar, i) => (
        <div class="bg-ink-950 p-8" data-reveal style={`transition-delay:${i * 80}ms`}>
          <span class="font-mono text-xs text-fg-subtle">{`0${i + 1}`}</span>
          <h3 class="mt-4 text-xl font-display font-medium">{pillar.title}</h3>
          <p class="mt-3 text-fg-muted text-sm leading-relaxed">{pillar.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
